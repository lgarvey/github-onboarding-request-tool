# Copy to .env for local development. Values here are safe local defaults, not secrets.
DEBUG=True
SECRET_KEY=local-dev-only-not-a-secret
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://postgres:postgres@db:5432/github_access

# Where the terraform-github config is read from (read-only). Defaults to the sample tree
# checked into this repo. Point it at a real checkout with an absolute path, or a relative
# one starting with ./ (docker compose needs the ./ to treat it as a directory).
TERRAFORM_GITHUB_PATH=./terraform-github-sample

# Where the world directory (people, intranet teams, SSO apps, exclusions) is read from.
# Defaults to the synthetic data in world-sample/. Mounted read-only. For the demo data that
# matches world-sample/, set TERRAFORM_GITHUB_PATH=./terraform-github-demo too.
WORLD_PATH=./world-sample

# When an approver approves a request, write the change into the YAML under the path above.
# Off when unset, so nothing is ever written to a real checkout unless you ask for it.
APPLY_APPROVED_CHANGES=True

# Sign in with the Django admin login form instead of Staff SSO. Local development only:
# leave it unset anywhere real. Accepts True/False, on/off, 1/0. Needs a restart to change.
DISABLE_SSO=True

# Staff SSO (authbroker). Placeholders are fine while DISABLE_SSO is on.
AUTHBROKER_URL=https://sso.example.invalid
AUTHBROKER_CLIENT_ID=replace-me
AUTHBROKER_CLIENT_SECRET=replace-me
